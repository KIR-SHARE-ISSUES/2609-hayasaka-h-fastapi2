{
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write js/*.js css/*.css index.html",
    "format:check": "prettier --check js/*.js css/*.css index.html"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "singleQuote": false
  }
}
